<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activityAbout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Back Button at Top -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturn"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:cornerRadius="12dp"
            app:iconTint="@null"
            app:icon="@drawable/back"
            app:iconSize="24dp"
            android:backgroundTint="@color/green"
            android:layout_marginBottom="12dp"/>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Section 1: App Purpose -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#20FFFFFF"
                    android:backgroundTint="#1AFFFFFF">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Purpose"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#2ab407"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvAboutPurpose"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:alpha="0.9"
                            android:text="SafeBite is your personal food safety companion. Instantly scan barcodes, detect allergens and hidden ingredients, and make informed food choices to protect yourself and your loved ones." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 2: Community Impact -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#20FFFFFF"
                    android:backgroundTint="#1AFFFFFF">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Community Impact"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#2ab407"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvAboutCommunity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:alpha="0.9"
                            android:text="SafeBite empowers a community of conscious eaters. Users can share experiences, alert others about allergens, and help build a safer food ecosystem for everyone." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 3: Team Vision -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#20FFFFFF"
                    android:backgroundTint="#1AFFFFFF">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Our Vision"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#2ab407"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvAboutTeam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:alpha="0.9"
                            android:text="Developed by Concurrent, SafeBite was created to make food safety simple, reliable, and community-driven. Our focus is on giving users accurate allergen data and empowering informed choices with minimal effort." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>
    </LinearLayout>
</FrameLayout>