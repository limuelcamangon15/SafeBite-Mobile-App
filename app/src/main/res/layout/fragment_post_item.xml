<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.8dp"
    app:strokeColor="#20FFFFFF"
    android:backgroundTint="#14FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Mood color bar at top of card -->
        <View
            android:id="@+id/moodBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#F5C842"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- User row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/userIconIv"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/usericon"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_bg"
                    android:clipToOutline="true"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/usernameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginBottom="3dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/mood_pill_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:text="Is feeling "
                            android:textColor="#80FFFFFF"/>

                        <TextView
                            android:id="@+id/emojiTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:text=""/>

                        <ImageView
                            android:id="@+id/ivEmojiIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="3dp"
                            android:layout_gravity="center_vertical"/>

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#4DFFFFFF"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/ibOptions"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ellipsis_solid"
                    android:visibility="gone"
                    />

            </LinearLayout>

            <!-- Food image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0.8dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:strokeColor="#15FFFFFF">

                <ImageView
                    android:id="@+id/foodImageIv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Food title -->
            <TextView
                android:id="@+id/foodTitleTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:text=""/>

            <!-- Brand -->
            <TextView
                android:id="@+id/brandTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#80FFFFFF"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:text=""/>

            <!-- Allergens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALLERGENS"
                    android:textSize="10sp"
                    android:textColor="#4DFFFFFF"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvAllergens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#99FFFFFF"
                    android:background="@drawable/allergen_chip_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

            </LinearLayout>

            <!-- Post comment with left mood accent bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/mood_comment_bg">

                <View
                    android:id="@+id/moodCommentBar"
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_alignTop="@id/postContentTv"
                    android:layout_alignBottom="@id/postContentTv"
                    android:layout_alignParentStart="true"
                    android:background="#F5C842"/>

                <TextView
                    android:id="@+id/postContentTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/moodCommentBar"
                    android:padding="12dp"
                    android:text="Your dynamic content here..."
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>