<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activityPostForm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help Others Stay "
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe"
                android:textStyle="bold"
                android:textSize="23sp"
                android:textColor="@color/light_green"
                />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Your Experience can help others avoid harmful ingredients."
            android:textColor="@color/white"
            />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.8dp"
            app:strokeColor="#20FFFFFF"
            android:backgroundTint="#14FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/moodBar"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="#F5C842"
                    android:visibility="gone"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0.8dp"
                        app:cardBackgroundColor="#1AFFFFFF"
                        app:strokeColor="#15FFFFFF"
                        >

                        <ImageView
                            android:id="@+id/foodImageIv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvFoodTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center_horizontal"
                        android:text="Product Name"/>

                    <TextView
                        android:id="@+id/tvBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#80FFFFFF"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:text="Brand Name"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALLERGENS"
                            android:textSize="10sp"
                            android:textColor="#4DFFFFFF"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/tvAllergens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="None"
                            android:textSize="13sp"
                            android:textColor="#99FFFFFF"
                            android:background="@drawable/allergen_chip_bg"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How do you feel about this product?"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp"
                        android:paddingBottom="12dp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/emoji1"
                                android:tag="Angry"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:icon="@drawable/angryemoji"
                                app:iconTint="@null"
                                app:iconSize="30dp"
                                app:backgroundTint="#20FFFFFF"
                                app:cornerRadius="12dp"
                                app:strokeWidth="0dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Angry"
                                android:textSize="10sp"
                                android:textColor="#80FFFFFF"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/emoji2"
                                android:tag="Happy"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:icon="@drawable/likeemoji"
                                app:iconTint="@null"
                                app:iconSize="30dp"
                                app:backgroundTint="#20FFFFFF"
                                app:cornerRadius="12dp"
                                app:strokeWidth="0dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Happy"
                                android:textSize="10sp"
                                android:textColor="#80FFFFFF"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/emoji3"
                                android:tag="Sad"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:icon="@drawable/sademoji"
                                app:iconTint="@null"
                                app:iconSize="30dp"
                                app:backgroundTint="#20FFFFFF"
                                app:cornerRadius="12dp"
                                app:strokeWidth="0dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sad"
                                android:textSize="10sp"
                                android:textColor="#80FFFFFF"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/emoji4"
                                android:tag="Neutral"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:icon="@drawable/neutralemoji"
                                app:iconTint="@null"
                                app:iconSize="30dp"
                                app:backgroundTint="#20FFFFFF"
                                app:cornerRadius="12dp"
                                app:strokeWidth="0dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Neutral"
                                android:textSize="10sp"
                                android:textColor="#80FFFFFF"/>
                        </LinearLayout>

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/mood_comment_bg">

                        <View
                            android:id="@+id/moodCommentBar"
                            android:layout_width="4dp"
                            android:layout_height="0dp"
                            android:layout_alignTop="@id/etPostContent"
                            android:layout_alignBottom="@id/etPostContent"
                            android:layout_alignParentStart="true"
                            android:background="#F5C842"
                            android:visibility="gone"
                            />

                        <EditText
                            android:id="@+id/etPostContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="80dp"
                            android:layout_toEndOf="@id/moodCommentBar"
                            android:background="@android:color/transparent"
                            android:padding="12dp"
                            android:hint="Leave your thoughts here..."
                            android:textColorHint="#4DFFFFFF"
                            android:gravity="top"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        >
                        <TextView
                            android:id="@+id/tvPostContentCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="0"
                            android:textColor="#4DFFFFFF"
                            android:textSize="10sp"
                            android:paddingTop="4dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="/200"
                            android:textColor="#4DFFFFFF"
                            android:textSize="10sp"
                            android:paddingTop="4dp"/>
                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUBMIT"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="12dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/green"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="12dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/white2"/>

    </LinearLayout>

  </ScrollView>
</FrameLayout>